# Connexion propriétaire (migrations, seed)
DATABASE_URL=postgres://jamystock:jamystock@localhost:5432/jamystock
# Connexion applicative (rôle sans BYPASSRLS, membre de jamystock_app)
APP_DATABASE_URL=postgres://jamystock_api:jamystock_api@localhost:5432/jamystock
JWT_SECRET=change-me-with-at-least-32-random-characters
PORT=3000
# Exiger le MFA pour SUPER_ADMIN et DISPATCHER (désactivable en dev)
MFA_ENFORCE=false
TENANT_ID=
STORAGE_DIR=.storage
# Tâches de facturation (instantanés 23 h 59, brouillons le 1er à 2 h, émission J+2) : on | off
# Par défaut : actives en production et sur Render, inactives en développement.
BILLING_SCHEDULER=off
